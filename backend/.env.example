# This file contains the environment variables needed to run the backend.
# Copy this file to a new file named .env and fill in the values.

# The connection string for your PostgreSQL database. Get this from your database provider (ex. Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Your API key for the Google Gemini models. Get this from Google AI Studio.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"